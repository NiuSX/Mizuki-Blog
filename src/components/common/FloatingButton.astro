---
// 从 astro-icon 导入 Icon 组件
import { Icon } from "astro-icon/components";

/**
 * 浮动按钮组件属性定义
 */
interface Props {
	/** 元素 id（供外部脚本定位或控制显示隐藏） */
	id: string;
	/** 图标名（如 "fa6-solid:arrow-up"） */
	icon: string;
	/** 无障碍标签（读屏器朗读的文本） */
	ariaLabel?: string;
	/** 内联 onclick 处理器（字符串形式） */
	onclick?: string;
	/** 外部传入的额外类名 */
	class?: string;
}

// 解构 props，class 重命名为 className 避免保留字冲突
const { id, icon, ariaLabel, onclick, class: className = "" } = Astro.props;
---

<!--
  外层容器：
  - id: 供外部脚本控制（如滚动时显示/隐藏）
  - class:list 拼接基础类 + 外部类 + 布局类
  - onclick: 直接透传内联点击处理器
-->
<div
	id={id}
	class:list={[
		"floating-btn",
		className,
		"btn-card flex items-center rounded-2xl overflow-hidden transition",
	]}
	onclick={onclick}
>
	<!-- 内层按钮：撑满容器，承载无障碍标签 -->
	<button aria-label={ariaLabel} class="h-full w-full rounded-2xl">
		<!-- 图标：mx-auto 水平居中 -->
		<Icon name={icon} class="mx-auto" />
	</button>
</div>

<!--
  stylus 预处理器语法（缩进式，无花括号分号）
  Astro 支持 <style lang="stylus">，会在构建时编译为 CSS
-->
<style lang="stylus">
	/* 浮动按钮基础样式 */
	.floating-btn
	color: var(--primary)              // 主色文字/图标
	font-size: 1.5rem                 // 基础字号
				  font-weight: bold
				  width: 3rem                       // 48px 宽
						  height: 3rem                      // 48px 高
								   opacity: 1
	cursor: pointer
	pointer-events: auto              // 确保可点击（覆盖父级可能的 none）
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1)  // 标准缓动曲线
	border-radius: 1rem
					border: 1px solid rgba(148, 163, 184, 0.45)  // 半透明边框（亮色模式）
	flex-shrink: 0                    // 防止在 flex 布局中被压缩
	overflow: hidden

		// 穿透作用域选中内部 SVG（astro-icon 渲染出的元素）
	:global(svg)
	font-size: 1.6rem
				  opacity: 1
	// 延迟 0.1s 后淡入，避免与容器动画冲突
	transition: opacity 0.2s ease 0.1s

										 // ===== 隐藏状态（通过 JS 切换 .hide 类） =====
									 &.hide
									 transform: scale(0.5)         // 缩小
	opacity: 0                    // 透明
	pointer-events: none          // 禁用交互
		// 以下用 !important 强制归零，避免被其它样式覆盖导致"隐身但仍占位"
	height: 0 !important
	width: 0 !important
	margin: 0 !important
	border-width: 0 !important
	padding: 0 !important

	// 隐藏时 SVG 快速淡出（无延迟）
	:global(svg)
	opacity: 0
	transition: opacity 0.1s ease

							   // 按下时轻微缩小，提供触感反馈
						   &:active
						   transform: scale(0.9)

	// 悬停：主色 + 阴影
	&:hover
	color: var(--primary)
	box-shadow: var(--shadow-button)

	// 激活状态（如"回到顶部"在滚动时的高亮）
	&.active
	background: var(--btn-card-bg-active)

	// 暗色模式覆盖
	:global(.dark) .floating-btn
	border: 1px solid rgba(255, 255, 255, 0.15)  // 亮边框更明显
	color: var(--primary, #60a5fa)               // 带兜底色

	&:hover
	color: var(--primary)
	box-shadow: var(--shadow-button-dark)

	// 平板/小屏适配
	@media (max-width: 768px)
	.floating-btn
	width: 2.75rem
			   height: 2.75rem
						   font-size: 1.4rem
										 border-radius: 0.75rem

															:global(svg)
															font-size: 1.4rem

	// 手机适配
	@media (max-width: 480px)
	.floating-btn
	width: 2.5rem
			  height: 2.5rem
						 font-size: 1.25rem
										border-radius: 0.5rem

														  :global(svg)
														  font-size: 1.2rem

																			// ===== 补充规则：与上面的 .floating-btn 合并 =====
																			// Stylus 允许多次声明同一选择器，会合并属性
																		.floating-btn
																		min-width: 0
	min-height: 0
	padding: 0.25rem

				 &.hide
				 padding: 0
</style>
---
// 导入组件属性类型
import type { PageHeaderProps } from "./types";

// 解构 props（用 as 标注类型）
// class 重命名为 className，避免与保留字冲突
const {
	title,              // 页面标题（必填）
	subtitle,           // 副标题（可选）
	class: className = "",  // 外部类名
} = Astro.props as PageHeaderProps;
---

<!-- 外层容器：纵向排列、左对齐，底部留白 2rem -->
<div class={`flex flex-col items-start justify-center mb-8 ${className}`}>
	<!--
	  主标题：
	  - relative 为伪元素提供定位上下文
	  - before:* 系列用伪元素绘制左侧主色竖条装饰
	    · before:w-1 before:h-8   → 4px 宽、32px 高的竖条
	    · before:bg-(--primary)   → 主色
	    · before:absolute before:top-1/2 before:-translate-y-1/2
	      → 绝对定位并在垂直方向居中
	    · before:-left-4          → 向左偏移 1rem，与文字保持间距
	-->
	<h1
		class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
			before:w-1 before:h-8 before:rounded-md before:bg-(--primary)
			before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
	>
		{title}
	</h1>

	<!-- 副标题：仅在传入时渲染，字号稍小、颜色弱化 -->
	{
		subtitle && (
			<p class="text-lg text-black/60 dark:text-white/60">{subtitle}</p>
		)
	}
</div>
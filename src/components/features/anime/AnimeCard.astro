---
// 导入项目通用的 Image 组件（支持响应式、多格式、Astro 优化）
import Image from "@components/atoms/Image/Image.astro";

/**
 * 组件属性定义
 */
interface Props {
	/** 番剧数据（来自 bangumi-data.json 或 bilibili-data.json） */
	anime: {
		title: string;          // 标题
		cover: string;          // 封面图 URL
		link: string;           // 详情页链接
		status: string;         // 状态（watching/completed/planned 等）
		rating: number;         // 评分
		progress: number;       // 已看集数
		totalEpisodes: number;  // 总集数
		description: string;    // 简介
		year: string;           // 年份
		studio: string;         // 制作公司/地区
		genre: string[];        // 类型标签
	};
	/** 状态展示信息（由父组件计算后传入） */
	statusInfo: {
		text: string;   // 状态文本
		class: string;  // 状态徽章的 CSS 类（不同状态不同配色）
		icon: string;   // 状态图标（emoji 或符号）
	};
	/** 年份标签的本地化文本 */
	yearLabel: string;
	/** 制作公司的本地化文本 */
	studioLabel: string;
}

// 解构 props
const { anime, statusInfo, yearLabel, studioLabel } = Astro.props;

/**
 * 观看进度百分比
 * 总集数为 0 时视为 0%（避免除零）
 */
const progressPercent =
	anime.totalEpisodes > 0 ? (anime.progress / anime.totalEpisodes) * 100 : 0;
---

<!--
  卡片根容器：
  - data-anime-status 供筛选脚本按状态过滤
  - group 配合 group-hover 实现父悬停子响应
  - 悬停加阴影
-->
<div
	class="group relative bg-(--card-bg) border border-(--line-divider) rounded-(--radius-large) overflow-hidden hover:shadow-lg"
	data-anime-status={anime.status}
>
	<!-- 封面区：固定 2:3 竖版比例（番剧海报标准比例） -->
	<div class="relative anime-cover-container aspect-2/3 overflow-hidden">
		<!-- 封面链接：点击跳转详情页（新标签打开，带安全 rel） -->
		<a
			href={anime.link}
			target="_blank"
			rel="noopener noreferrer"
			class="block w-full h-full"
		>
			<!--
			  封面图：使用通用 Image 组件
			  - widths: 提供 200/400/600 三个尺寸供浏览器选择
			  - sizes: 告诉浏览器不同视口下图片的显示宽度
			  - 悬停放大 110%
			-->
			<Image
				src={anime.cover}
				alt={anime.title}
				class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
				widths={[200, 400, 600]}
				sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 20vw"
			/>
			<!--
			  悬停遮罩 + 播放按钮：
			  默认透明，悬停时淡入，暗示"可点击观看"
			-->
			<div
				class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
			>
				<!-- 中央播放按钮 -->
				<div class="absolute inset-0 flex items-center justify-center">
					<div
						class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center"
					>
						<!-- 播放三角形图标（ml-1 视觉居中） -->
						<svg
							class="w-6 h-6 text-gray-800 ml-1"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path d="M8 5v14l11-7z"></path>
						</svg>
					</div>
				</div>
			</div>
		</a>

		<!-- 左上角状态徽章：配色由 statusInfo.class 决定 -->
		<div
			class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
		>
			<span class="mr-1">{statusInfo.icon}</span>
			<span>{statusInfo.text}</span>
		</div>

		<!-- 右上角评分徽章：星星图标 + 分数 -->
		<div
			class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1"
		>
			<svg
				class="w-3 h-3 text-yellow-400"
				fill="currentColor"
				viewBox="0 0 20 20"
			>
				<path
					d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
				></path>
			</svg>
			<span>{anime.rating}</span>
		</div>

		<!--
		  底部进度条：仅在"在看"状态显示
		  包含进度条 + 集数文本
		-->
		{
			anime.status === "watching" && (
				<div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-black/80 to-transparent p-2">
					<!-- 进度条轨道 -->
					<div class="w-full bg-white/20 rounded-full h-1.5 mb-1">
						<!-- 进度条填充：宽度由 progressPercent 决定，渐变绿青色 -->
						<div
							class="bg-linear-to-r from-emerald-400 to-teal-400 h-1.5 rounded-full transition-all duration-300"
							style={`width: ${progressPercent}%`}
						/>
					</div>
					<!-- 进度文本：如 "5/12 (42%)" -->
					<div class="text-white text-xs font-medium">
						{anime.progress}/{anime.totalEpisodes} (
						{Math.round(progressPercent)}%)
					</div>
				</div>
			)
		}
	</div>

	<!-- 信息区：标题、简介、年份、制作公司、类型标签 -->
	<div class="p-3">
		<!-- 标题 -->
		<h3
			class="text-sm font-bold text-black/90 dark:text-white/90 mb-1 leading-tight"
		>
			{anime.title}
		</h3>
		<!-- 简介：两行截断，title 属性提供悬停完整文本 -->
		<p
			class="text-black/60 dark:text-white/60 text-xs mb-2 line-clamp-2"
			title={anime.description}
		>
			{anime.description}
		</p>

		<div class="space-y-1 text-xs">
			<!-- 年份行：标签左、值右 -->
			<div class="flex justify-between items-center">
				<span class="text-black/50 dark:text-white/50 shrink-0">
					{yearLabel}
				</span>
				<span
					class="text-black/70 dark:text-white/70 truncate ml-2 text-right"
				>
					{anime.year}
				</span>
			</div>
			<!-- 制作公司行：值可能较长，两行截断 + 允许换行 -->
			<div class="flex justify-between items-start">
				<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
					{studioLabel}
				</span>
				<span
					class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 wrap-break-word"
					title={anime.studio}
				>
					{anime.studio}
				</span>
			</div>
			<!-- 类型标签：可换行 -->
			<div class="flex flex-wrap gap-1 mt-2">
				{
					anime.genre.map((g) => (
						<span class="px-1.5 py-0.5 bg-(--btn-regular-bg) text-black/70 dark:text-white/70 rounded text-xs">
							{g}
						</span>
					))
				}
			</div>
		</div>
	</div>
</div>
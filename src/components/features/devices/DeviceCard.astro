---
// 导入设备数据类型
import type { Device } from "@/data/devices";

/**
 * 组件属性定义
 */
interface Props {
	/** 设备数据对象 */
	device: Device;
	/** 索引（用于计算入场动画延迟） */
	index: number;
	/** "查看详情"按钮的文本（由父组件传入，便于 i18n） */
	viewDetailsText: string;
}

// 解构 props
const { device, index, viewDetailsText } = Astro.props;
---

<!--
  整卡链接：
  - 点击任意位置跳转设备详情页（新标签打开，带安全 rel）
  - style 动态设置 animation-delay，实现逐个延迟入场
  - group 配合内部 group-hover 实现父悬停子响应
-->
<a
	href={device.link}
	target="_blank"
	rel="noopener noreferrer"
	class="device-card group relative overflow-hidden rounded-xl border border-(--line-divider) bg-(--card-bg) transition-all duration-300 hover:border-(--primary)/50 hover:shadow-md hover:shadow-black/5 dark:hover:shadow-white/5 hover:scale-[1.02] hover:-translate-y-0.5 block cursor-pointer"
	style={`animation-delay: ${index * 100}ms`}
>
	<!-- 设备图片区域 -->
	<div class="relative p-6 pb-0">
		<!-- 图片容器：渐变背景，相对定位（供内部绝对定位元素用） -->
		<div
			class="flex justify-center items-center h-48 bg-linear-to-br from-(--card-bg) to-(--btn-regular-bg) rounded-lg overflow-hidden relative"
		>
			<!-- 悬停时叠加的淡主色层（默认透明） -->
			<div
				class="absolute inset-0 bg-(--primary)/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
			>
			</div>
			<!--
			  设备图：
			  - h-full + object-contain：保持宽高比完整显示（不裁剪）
			  - drop-shadow-md：投影增加立体感
			  - z-10：确保在叠加层之上
			  - 悬停放大 110%
			-->
			<img
				src={device.image}
				alt={device.name}
				class="w-auto h-full max-h-full object-contain group-hover:scale-110 transition-all duration-500 drop-shadow-md relative z-10"
				loading="lazy"
			/>
		</div>
	</div>

	<!-- 设备信息区域 -->
	<div class="p-6 pt-4 relative z-10">
		<!-- 标题行：名称 + 外链图标 -->
		<div class="flex items-start justify-between mb-3">
			<!-- 设备名称：悬停时变主色 -->
			<h3
				class="text-lg font-bold text-black/90 dark:text-white/90 group-hover:text-(--primary) transition-colors duration-300"
			>
				{device.name}
			</h3>
			<!-- 外链图标：默认隐藏，悬停时淡入 -->
			<div
				class="p-1.5 rounded-full bg-(--primary)/10 text-(--primary) opacity-0 group-hover:opacity-100 transition-opacity duration-300"
			>
				<svg
					class="w-5 h-5"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
					></path>
				</svg>
			</div>
		</div>

		<div class="mb-4">
			<!-- 规格徽章：齿轮图标 + 规格文本 -->
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-(--btn-regular-bg) text-black/70 dark:text-white/70 text-sm mb-3"
			>
				<svg
					class="w-4 h-4"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
					></path>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				<span class="font-medium">{device.specs}</span>
			</div>

			<!-- 设备描述：两行截断 -->
			<p
				class="text-sm text-black/60 dark:text-white/60 leading-relaxed line-clamp-2"
			>
				{device.description}
			</p>
		</div>

		<!-- 查看详情按钮：默认隐藏，悬停时淡入 -->
		<div
			class="flex items-center justify-between pt-3 border-t border-(--line-divider) border-dashed opacity-0 group-hover:opacity-100 transition-all duration-300"
		>
			<!-- 文本由 props 传入（i18n） -->
			<span class="text-sm font-medium text-(--primary)"
			>{viewDetailsText}</span
			>
			<!-- 右箭头图标 -->
			<svg
				class="w-5 h-5 text-(--primary)"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
			</svg>
		</div>
	</div>
</a>

<style>
	/* 卡片入场动画：向上淡入，带缓动曲线 */
	.device-card {
		animation: fadeInUp 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
		opacity: 0;
	}

	/* 两行截断（本地实现） */
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
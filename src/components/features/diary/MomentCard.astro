---
// 导入 astro-icon 的 Icon 组件
import { Icon } from "astro-icon/components";

// 导入相对时间格式化函数（与客户端版功能相同，但这里是服务端调用）
import { formatRelativeTime } from "../../../utils/timeFormat";
// 导入卡片属性类型
import type { MomentCardProps } from "./types";

// 解构 props（用 as 标注类型）
const { moment, index, minutesAgo, hoursAgo, daysAgo } =
	Astro.props as MomentCardProps;

// 服务端计算相对时间（如 "3小时前"）
// 与 renderMomentCard 的客户端版本不同，这里在构建时就算好，避免运行时计算
const relativeTime = formatRelativeTime(
	moment.date,
	minutesAgo,
	hoursAgo,
	daysAgo,
);
---

<!--
  卡片容器：
  - data-tags 供外部筛选脚本按标签过滤
  - group 配合 group-hover 实现父悬停子响应
  - 悬停上浮 + 阴影
-->
<div
	class="moment-card group relative bg-transparent rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
	data-tags={moment.tags?.join(",") || ""}
>
	<div class="p-5">
		<!-- 正文内容（Astro 自动转义，无需手动 escapeHtml） -->
		<p
			class="text-sm md:text-base text-black/90 dark:text-white/90 leading-relaxed mb-3"
		>
			{moment.content}
		</p>

		<!--
		  图片区：
		  class:list 根据图片数量动态选择布局类
		  - 1 张：单图（大图，限宽 400~500px）
		  - 2 张：两列
		  - 3 张：首图占两行 + 右侧两张
		  - 4+ 张：自动填充网格
		-->
		{
			moment.images && moment.images.length > 0 && (
				<div
					class:list={[
						"diary-images grid gap-2 mb-3",
						moment.images.length === 1 && "diary-images-single",
						moment.images.length === 2 && "diary-images-double",
						moment.images.length === 3 && "diary-images-triple",
						moment.images.length >= 4 && "diary-images-grid",
					]}
				>
					{moment.images.map((image, imgIndex) => (
						<div class="relative rounded-lg overflow-hidden aspect-square cursor-pointer">
							<!--
							  fancybox 分组名：diary-{卡片索引}-{图片索引}
							  同一条日记的图片可左右切换，不同日记互不干扰
							-->
							<a
								href="javascript:void(0)"
								data-src={image}
								data-fancybox={`diary-${index}-${imgIndex}`}
								class="block w-full h-full"
							>
								<img
									src={image}
									alt="diary moment image"
									class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
									loading="lazy"
									decoding="async"
								/>
							</a>
						</div>
					))}
				</div>
			)
		}

		<!-- 标签列表：可换行 -->
		{
			moment.tags && moment.tags.length > 0 && (
				<div class="flex flex-wrap gap-1.5 mb-3">
					{moment.tags.map((tag: string) => (
						<span class="btn-regular h-6 text-xs px-2 rounded-lg">
							{tag}
						</span>
					))}
				</div>
			)
		}

		<!-- 分隔线 -->
		<hr class="border-t border-black/5 dark:border-white/5 my-3" />

		<!-- 底部信息栏：左侧时间，右侧位置/心情 -->
		<div
			class="flex items-center justify-between text-xs text-black/50 dark:text-white/50 flex-wrap gap-2"
		>
			<!-- 左侧：时钟图标 + 相对时间 -->
			<div class="flex items-center gap-1.5">
				<Icon
					name="material-symbols:schedule"
					class="text-xs w-3.5 h-3.5"
				/>
				<!-- datetime 属性用于语义化时间标记（SEO/无障碍） -->
				<time datetime={moment.date}>{relativeTime}</time>
			</div>

			<!-- 右侧：位置 + 心情（均为可选） -->
			<div class="flex items-center gap-3">
				{
					moment.location && (
						<span class="flex items-center gap-1">
							<Icon
								name="material-symbols:location-on"
								class="text-xs w-3.5 h-3.5"
							/>
							{moment.location}
						</span>
					)
				}
				{
					moment.mood && (
						<span class="flex items-center gap-1">
							{moment.mood}
						</span>
					)
				}
			</div>
		</div>
	</div>

	<!-- 悬停渐变叠层：默认透明，悬停时淡入 -->
	<div
		class="absolute inset-0 bg-linear-to-br from-(--primary)/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-xl"
	>
	</div>
</div>

<!--
  is:global 使样式穿透组件作用域，成为全局样式。
  原因：这些类（.moment-card / .diary-images-*）在客户端动态渲染的 HTML 中也会用到，
  而动态内容不受 Astro 的作用域隔离约束，所以必须全局化。
-->
<style is:global>
	/* 卡片入场动画：从下方淡入 */
	.moment-card {
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	/* 被筛选脚本标记为过滤掉时隐藏 */
	.moment-card.filtered-out {
		display: none;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 逐个延迟入场：形成"瀑布式"出现效果 */
	.moment-card:nth-child(1) { animation-delay: 0.03s; }
	.moment-card:nth-child(2) { animation-delay: 0.06s; }
	.moment-card:nth-child(3) { animation-delay: 0.09s; }
	.moment-card:nth-child(4) { animation-delay: 0.12s; }
	.moment-card:nth-child(5) { animation-delay: 0.15s; }
	.moment-card:nth-child(6) { animation-delay: 0.18s; }
	.moment-card:nth-child(7) { animation-delay: 0.21s; }
	.moment-card:nth-child(8) { animation-delay: 0.24s; }
	.moment-card:nth-child(9) { animation-delay: 0.27s; }
	.moment-card:nth-child(10) { animation-delay: 0.3s; }
	.moment-card:nth-child(11) { animation-delay: 0.33s; }
	.moment-card:nth-child(12) { animation-delay: 0.36s; }

	/* 1 张图：单列大图，限宽 400px */
	.diary-images-single {
		grid-template-columns: 1fr;
		max-width: 400px;
	}

	/* 2 张图：两列，限宽 500px */
	.diary-images-double {
		grid-template-columns: repeat(2, 1fr);
		max-width: 500px;
	}

	/* 3 张图：两列布局，首图跨两行 */
	.diary-images-triple {
		grid-template-columns: repeat(2, 1fr);
		max-width: 500px;
	}
	.diary-images-triple > :first-child {
		grid-row: span 2;  /* 首图占两行高度 */
	}

	/* 4+ 张图：自动填充网格（每列最小 140px） */
	.diary-images-grid {
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		max-width: 600px;
	}

	/* 平板及以上：放大尺寸与限宽 */
	@media (width >= 768px) {
		.diary-images-single {
			max-width: 500px;
		}
		.diary-images-double {
			max-width: 560px;
		}
		.diary-images-triple {
			max-width: 560px;
		}
		.diary-images-grid {
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			max-width: 700px;
		}
	}

	/* 小屏手机：3 张图改为普通两列（取消首图跨行） */
	@media (width < 480px) {
		.diary-images-triple {
			grid-template-columns: repeat(2, 1fr);
		}
		.diary-images-triple > :first-child {
			grid-row: span 1;  /* 取消跨行，避免小屏挤压缩小 */
		}
	}
</style>
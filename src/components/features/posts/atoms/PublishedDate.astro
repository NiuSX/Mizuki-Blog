---
// 导入 astro-icon 的 Icon 组件
import { Icon } from "astro-icon/components";

// 导入日期格式化工具
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

/**
 * 组件属性定义
 */
interface Props {
	/** 日期对象 */
	date: Date;
	/** 是否只显示日期（不含时间），默认 false */
	dateOnly?: boolean;
	/** 外部传入的额外类名 */
	class?: string;
}

// 解构 props
// dateOnly 默认 false（显示日期 + 时间）
const { date, dateOnly = false, class: className } = Astro.props;
---

<!-- 容器：横向排列，图标 + 日期文字，应用外部类名 -->
<div class:list={["flex items-center", className]}>
	<!-- 图标：日历图标（表示"发布日期"） -->
	<div class="meta-icon">
		<Icon
			name="material-symbols:calendar-today-outline-rounded"
			class="text-xl"
		/>
	</div>
	<!-- 日期文字：格式化后的 YYYY-MM-DD（或含时间） -->
	<span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(date, dateOnly)}</span
	>
</div>
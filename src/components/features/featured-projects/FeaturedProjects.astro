---
// 从 projects 模块导入 ProjectCard 组件（单个项目卡片）
import { ProjectCard } from "../projects";
// 导入 SectionTitle 组件（区块标题）
import { SectionTitle } from "../section-title";
// 导入组件属性类型
import type { FeaturedProjectsProps } from "./types";

// 解构 props（用 as 标注类型）
// class 重命名为 className，避免与保留字冲突
const {
	projects,           // 精选项目列表
	title,              // 区块标题（可选）
	class: className = "",  // 外部类名
} = Astro.props as FeaturedProjectsProps;
---

<!-- 外层容器：应用外部类名 -->
<div class={className}>
	<!-- 可选标题：仅在传入 title 时渲染 SectionTitle -->
	{title && <SectionTitle title={title} />}

	<!--
	  项目网格：
	  - 手机：单列
	  - 平板及以上：两列
	  - 间距 1.5rem
	-->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		{
			// 遍历项目列表，每个渲染为一个大尺寸卡片
			projects.map((project) => (
			<ProjectCard
				project={project}
				size="large"        // 使用大尺寸布局
			showImage={true}    // 显示项目配图
		maxTechStack={4}    // 最多显示 4 个技术栈标签
		/>
		))
		}
	</div>
</div>
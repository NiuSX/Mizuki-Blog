---
/**
	* 自定义滚动条组件的属性定义
	*/
export interface Props {
	/** 子内容（Astro 组件插槽内容） */
	children: unknown;
	/** 滚动方向：水平或垂直，默认水平 */
	orientation?: "horizontal" | "vertical";
	/** 外部传入的额外 CSS 类名 */
	class?: string;
}

// 解构 props，orientation 默认 "horizontal"
// class 重命名为 customClass，避免与保留字冲突
const {
	children,
	orientation = "horizontal",
	class: customClass = "",
} = Astro.props;
---

<!-- 滚动容器：
     - 基础类 custom-scrollbar + 方向类（horizontal-scrollbar / vertical-scrollbar）+ 外部类
     - data-orientation 供客户端脚本判断方向 -->
<div
	class={`custom-scrollbar ${orientation === "horizontal" ? "horizontal-scrollbar" : "vertical-scrollbar"} ${customClass}`}
	data-orientation={orientation}
>
	{children}
</div>

<style>
	/* 滚动容器基础：允许滚动、建立定位上下文（供伪元素/子元素绝对定位） */
	.custom-scrollbar {
		overflow: auto;
		position: relative;
	}

	/* 水平方向：横向可滚，纵向裁剪 */
	.horizontal-scrollbar {
		overflow-x: auto;
		overflow-y: hidden;
	}

	/* 垂直方向：纵向可滚，横向裁剪 */
	.vertical-scrollbar {
		overflow-y: auto;
		overflow-x: hidden;
	}

	/* 隐藏默认滚动条（WebKit 浏览器） */
	.custom-scrollbar::-webkit-scrollbar {
		display: none;
	}

	/* 隐藏默认滚动条（Firefox / IE / Edge） */
	.custom-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* 自定义滚动条轨道（用 ::after 伪元素绘制，始终存在但默认透明） */
	.custom-scrollbar::after {
		content: "";
		position: absolute;
		background: #e5e7eb; /* 浅灰色轨道 */
		border-radius: 4px;
		opacity: 0;
		transition: opacity 0.3s;
		/* 不响应鼠标事件，避免干扰内容滚动 */
		pointer-events: none;
	}

	/* 水平轨道的定位与尺寸 */
	.horizontal-scrollbar::after {
		bottom: 2px;
		left: 0;
		right: 0;
		height: 6px;
	}

	/* 垂直轨道的定位与尺寸 */
	.vertical-scrollbar::after {
		right: 2px;
		top: 0;
		bottom: 0;
		width: 6px;
	}

	/* 自定义滚动条拇指（用 ::before 伪元素绘制） */
	.custom-scrollbar::before {
		content: "";
		position: absolute;
		background: #6366f1; /* indigo-500 主题色 */
		border-radius: 4px;
		opacity: 0;
		transition: opacity 0.3s;
		pointer-events: none;
	}

	/* 水平拇指的尺寸约束 */
	.horizontal-scrollbar::before {
		bottom: 2px;
		height: 6px;
		min-width: 20px;
	}

	/* 垂直拇指的尺寸约束 */
	.vertical-scrollbar::before {
		right: 2px;
		width: 6px;
		min-height: 20px;
	}

	/* 悬停时显示滚动条（轨道 + 拇指） */
	.custom-scrollbar:hover::after,
	.custom-scrollbar:hover::before {
		opacity: 1;
	}

	/* 夜间模式样式 */
	.dark .custom-scrollbar::after {
		background: #374151; /* 夜间模式轨道色 */
	}

	.dark .custom-scrollbar::before {
		background: #6366f1; /* indigo-500 夜间模式拇指 */
	}

	/* 滚动时显示滚动条（active / focus 状态） */
	.custom-scrollbar:active::after,
	.custom-scrollbar:active::before,
	.custom-scrollbar:focus::after,
	.custom-scrollbar:focus::before {
		opacity: 1;
	}
</style>

<script>
	// ===== 定位当前组件实例的滚动容器 =====
	// 说明：document.currentScript 指向当前 <script> 标签本身，
	// 通过 parentElement.querySelector 定位到同组件内的滚动容器
	const scrollbarEl = document.currentScript?.parentElement?.querySelector(
		".custom-scrollbar",
	) as HTMLElement | null;

	if (scrollbarEl) {
		const el = scrollbarEl;
		// ===== 创建真正的滚动条元素（CSS 伪元素无法响应滚动位置，故用真实 DOM） =====
		const track = document.createElement("div");
		const thumb = document.createElement("div");

		// ===== 设置轨道样式 =====
		track.className = "custom-track";
		track.style.position = "absolute";
		track.style.background = "#e5e7eb"; // 浅灰色轨道
		track.style.borderRadius = "4px";
		track.style.opacity = "0";
		track.style.transition = "opacity 0.3s";
		track.style.pointerEvents = "none";
		track.style.zIndex = "10";

		// ===== 设置拇指样式 =====
		thumb.className = "custom-thumb";
		thumb.style.position = "absolute";
		thumb.style.background = "#6366f1"; // indigo-500 主题色
		thumb.style.borderRadius = "4px";
		thumb.style.opacity = "0";
		thumb.style.transition = "opacity 0.3s";
		thumb.style.pointerEvents = "none";
		thumb.style.zIndex = "10";

		// ===== 根据方向设置轨道和拇指的位置与尺寸 =====
		if (el.dataset.orientation === "horizontal") {
			// 水平：位于容器底部，横跨整个宽度
			track.style.bottom = "2px";
			track.style.left = "0";
			track.style.right = "0";
			track.style.height = "6px";

			thumb.style.bottom = "2px";
			thumb.style.height = "6px";
			thumb.style.minWidth = "20px";
		} else {
			// 垂直：位于容器右侧，纵跨整个高度
			track.style.right = "2px";
			track.style.top = "0";
			track.style.bottom = "0";
			track.style.width = "6px";

			thumb.style.right = "2px";
			thumb.style.width = "6px";
			thumb.style.minHeight = "20px";
		}

		// 将轨道与拇指挂载到滚动容器
		el.appendChild(track);
		el.appendChild(thumb);

		/**
		 * 根据当前滚动位置更新拇指的位置与尺寸
		 * 核心算法：
		 *   拇指尺寸 = 可视区 / 内容总尺寸 × 可视区尺寸（受最小值约束）
		 *   拇指位置 = 当前滚动量 / 可滚动总量 × 可移动范围
		 */
		function updateScrollbar() {
			if (el.dataset.orientation === "horizontal") {
				const scrollWidth = el.scrollWidth;
				const clientWidth = el.clientWidth;
				const scrollLeft = el.scrollLeft;

				// 仅当内容超出可视区时才需要滚动条
				if (scrollWidth > clientWidth) {
					// 拇指宽度：按可视区占比缩放，最小 20px
					const thumbWidth = Math.max(
						20,
						(clientWidth / scrollWidth) * clientWidth,
					);
					// 拇指左偏移：按滚动占比映射到可移动范围
					const thumbLeft =
						(scrollLeft / (scrollWidth - clientWidth)) *
						(clientWidth - thumbWidth);

					thumb.style.width = `${thumbWidth}px`;
					thumb.style.left = `${thumbLeft}px`;
				}
			} else {
				// 垂直方向同理
				const scrollHeight = el.scrollHeight;
				const clientHeight = el.clientHeight;
				const scrollTop = el.scrollTop;

				if (scrollHeight > clientHeight) {
					const thumbHeight = Math.max(
						20,
						(clientHeight / scrollHeight) * clientHeight,
					);
					const thumbTop =
						(scrollTop / (scrollHeight - clientHeight)) *
						(clientHeight - thumbHeight);

					thumb.style.height = `${thumbHeight}px`;
					thumb.style.top = `${thumbTop}px`;
				}
			}
		}

		/** 显示滚动条（轨道 + 拇指同时淡入） */
		function showScrollbar() {
			track.style.opacity = "1";
			thumb.style.opacity = "1";
		}

		/** 隐藏滚动条（轨道 + 拇指同时淡出） */
		function hideScrollbar() {
			track.style.opacity = "0";
			thumb.style.opacity = "0";
		}

		/** 根据当前主题（.dark 类）切换滚动条配色 */
		function updateTheme() {
			if (document.documentElement.classList.contains("dark")) {
				track.style.background = "#374151"; // 夜间模式轨道色
				thumb.style.background = "#6366f1"; // indigo-500 夜间模式拇指
			} else {
				track.style.background = "#e5e7eb"; // 浅灰色轨道
				thumb.style.background = "#6366f1"; // indigo-500 主题色
			}
		}

		// ===== 初始化 =====
		updateScrollbar();
		updateTheme();

		// ===== 事件监听 =====
		// 滚动时实时更新拇指位置
		el.addEventListener("scroll", updateScrollbar);
		// 鼠标进入容器时显示滚动条
		el.addEventListener("mouseenter", showScrollbar);
		// 鼠标离开容器时隐藏滚动条
		el.addEventListener("mouseleave", hideScrollbar);
		// 按下鼠标（准备拖拽/滚动）时显示
		el.addEventListener("mousedown", showScrollbar);
		// 全局松开鼠标时隐藏
		window.addEventListener("mouseup", hideScrollbar);

		// ===== 监听主题变化 =====
		// 用 MutationObserver 监听 <html> 上 class 的变化，
		// 当用户在亮/暗主题间切换时自动更新滚动条配色
		const observer = new MutationObserver(updateTheme);
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		// ===== 监听窗口尺寸变化 =====
		// 窗口大小变化会影响可视区尺寸，需要重新计算拇指尺寸与位置
		window.addEventListener("resize", updateScrollbar);
	}
</script>
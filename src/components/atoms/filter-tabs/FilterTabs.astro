---
// 导入 astro-icon 的 Icon 组件，用于渲染图标
import { Icon } from "astro-icon/components";

/**
 * 单个筛选标签的数据结构
 */
interface FilterTab {
    /** 标签的值（如 "all"、"anime"），用于筛选匹配 */
    value: string;
    /** 标签显示的文字 */
    label: string;
    /** 可选：图标名（如 "fa6-solid:list"） */
    icon?: string;
    /** 可选：计数（显示为 "(3)" 形式），为 undefined 时不渲染 */
    count?: number;
}

/**
 * 组件属性定义
 */
interface Props {
    /** 标签列表数据 */
    tabs: FilterTab[];
    /** 数据属性名，供客户端脚本识别"这组标签筛选的是哪个属性" */
    dataAttr: string;
    /** 当前激活的标签值，默认 "all" */
    activeValue?: string;
    /** 外部传入的额外 CSS 类名 */
    class?: string;
}

// 解构 props，activeValue 默认 "all"
// class 重命名为 className，避免与保留字冲突
const {
    tabs,
    dataAttr,
    activeValue = "all",
    class: className = "",
} = Astro.props;
---

<!-- 筛选标签容器：class:list 支持数组形式，自动处理条件类名 -->
<div class:list={["filter-tabs", className]}>
    {
        // 遍历标签列表，为每个标签渲染一个按钮
		tabs.map((tab) => (
            <button
        // class:list 中对象形式表示条件类名：tab.value === activeValue 时加上 "active"
        class:list={[
        "filter-tabs-item",
        { active: tab.value === activeValue },
    ]}
    // data-filter-value: 当前标签的值（客户端据此过滤）
    data-filter-value={tab.value}
    // data-filter-attr: 该组标签筛选的目标属性
    data-filter-attr={dataAttr}
    >
    {/* 可选图标：有 icon 字段时才渲染 */}
    {tab.icon && <Icon name={tab.icon} class="text-base w-4 h-4" />}
    {/* 标签文字 */}
    <span>{tab.label}</span>
    {/* 可选计数：count 存在（包括 0）时才渲染 */}
        {tab.count !== undefined && (
    <span class="filter-tabs-count">({tab.count})</span>
    )}
            </button>
    ))
    }
    </div>

    <style>
        /* 容器：flex 布局，允许换行，标签间距 0.5rem */
        .filter-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        /* 单个标签按钮 */
        .filter-tabs-item {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            border: 1px solid var(--line-divider);
            border-radius: var(--radius-large);
            background: var(--btn-regular-bg);
            color: var(--btn-content);
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            /* 防止标签内文字换行 */
            white-space: nowrap;
        }

        /* 图标：防止被压缩，默认半透明 */
        .filter-tabs-item iconify-icon {
            flex-shrink: 0;
            opacity: 0.7;
            transition: opacity 0.2s ease;
        }

        /* 悬停态（排除已激活项）：换背景色、边框变主色 */
        .filter-tabs-item:hover:not(.active) {
            background: var(--btn-regular-bg-hover);
            border-color: var(--primary);
        }

        /* 悬停时图标提升到完全不透明 */
        .filter-tabs-item:hover:not(.active) iconify-icon {
            opacity: 1;
        }

        /* 激活态：主色背景 + 白色文字 */
        .filter-tabs-item.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* 激活态图标完全不透明 */
        .filter-tabs-item.active iconify-icon {
            opacity: 1;
        }

        /* 计数文字：降低透明度、略小字号，视觉上弱化 */
        .filter-tabs-count {
            opacity: 0.6;
            font-size: 0.8rem;
        }

        /* 移动端（宽度 < 768px）适配 */
        @media (width < 768px) {
            /* 缩小标签间距 */
            .filter-tabs {
                gap: 0.375rem;
            }

            /* 缩小标签内边距与字号 */
            .filter-tabs-item {
                padding: 0.4rem 0.8rem;
                font-size: 0.8rem;
            }

            /* 移动端隐藏计数，节省空间 */
            .filter-tabs-count {
                display: none;
            }
        }
    </style>